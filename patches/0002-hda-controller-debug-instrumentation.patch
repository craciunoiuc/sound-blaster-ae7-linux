From: AE-7 debug rig <sound-card@example>
Subject: [PATCH] ALSA: hda: add HDACTRLDBG instrumentation for HDA controller probe

Adds HDACTRLDBG: dev_info prints at every step of the HDA controller probe path
so the boot log shows exactly where it hangs against the AE-7's ASMedia
PCIe-to-PCI bridge.

Isolation confirmed the controller driver (snd_hda_intel) is what hangs, NOT
the ca0132 codec. So this patches the controller layer:
  - sound/hda/controllers/intel.c       (azx_probe_continue)
  - sound/hda/common/controller.c       (probe_codec, azx_init_chip, azx_probe_codecs)
  - sound/hda/core/controller.c         (snd_hdac_bus_reset_link, snd_hdac_bus_init_chip)

Apply with:
    git -C kernel/ apply ../patches/0002-hda-controller-debug-instrumentation.patch

The last HDACTRLDBG line printed before the freeze is the exact hang point.

---
diff --git a/sound/hda/common/controller.c b/sound/hda/common/controller.c
index a84754675..c1bd833b8 100644
--- a/sound/hda/common/controller.c
+++ b/sound/hda/common/controller.c
@@ -1019,7 +1019,9 @@ EXPORT_SYMBOL_GPL(snd_hda_codec_load_dsp_cleanup);
  */
 void azx_init_chip(struct azx *chip, bool full_reset)
 {
+	dev_info(chip->card->dev, "HDACTRLDBG: azx_init_chip(full_reset=%d)\n", full_reset);
 	if (snd_hdac_bus_init_chip(azx_bus(chip), full_reset)) {
+		dev_info(chip->card->dev, "HDACTRLDBG: azx_init_chip bus_init_chip returned true\n");
 		/* correct RINTCNT for CXT */
 		if (chip->driver_caps & AZX_DCAPS_CTX_WORKAROUND)
 			azx_writew(chip, RINTCNT, 0xc0);
@@ -1120,6 +1122,7 @@ static int probe_codec(struct azx *chip, int addr)
 {
 	unsigned int cmd = (addr << 28) | (AC_NODE_ROOT << 20) |
 		(AC_VERB_PARAMETERS << 8) | AC_PAR_VENDOR_ID;
+	dev_info(chip->card->dev, "HDACTRLDBG: probe_codec(addr=%d) cmd=0x%08x\n", addr, cmd);
 	struct hdac_bus *bus = azx_bus(chip);
 	int err;
 	unsigned int res = -1;
@@ -1127,7 +1130,9 @@ static int probe_codec(struct azx *chip, int addr)
 	scoped_guard(mutex, &bus->cmd_mutex) {
 		chip->probing = 1;
 		azx_send_cmd(bus, cmd);
+		dev_info(chip->card->dev, "HDACTRLDBG: probe_codec after azx_send_cmd\n");
 		err = azx_get_response(bus, addr, &res);
+		dev_info(chip->card->dev, "HDACTRLDBG: probe_codec after azx_get_response (err=%d res=0x%x)\n", err, res);
 		chip->probing = 0;
 	}
 	if (err < 0 || res == -1)
@@ -1189,6 +1194,7 @@ int azx_probe_codecs(struct azx *chip, unsigned int max_slots)
 {
 	struct hdac_bus *bus = azx_bus(chip);
 	int c, codecs, err;
+	dev_info(chip->card->dev, "HDACTRLDBG: azx_probe_codecs max_slots=%d codec_mask=0x%lx probe_mask=0x%x\n", max_slots, bus->codec_mask, chip->codec_probe_mask);
 
 	codecs = 0;
 	if (!max_slots)
diff --git a/sound/hda/controllers/intel.c b/sound/hda/controllers/intel.c
index 4b03c64e7..1def3d325 100644
--- a/sound/hda/controllers/intel.c
+++ b/sound/hda/controllers/intel.c
@@ -2358,9 +2358,12 @@ static int azx_probe_continue(struct azx *chip)
 	 * this power. For other platforms, like Baytrail/Braswell, only the
 	 * display codec needs the power and it can be released after probe.
 	 */
+	dev_info(chip->card->dev, "HDACTRLDBG: azx_probe_continue start, before display_power\n");
 	display_power(chip, true);
+	dev_info(chip->card->dev, "HDACTRLDBG: after display_power\n");
 
 	err = azx_first_init(chip);
+	dev_info(chip->card->dev, "HDACTRLDBG: after azx_first_init (err=%d)\n", err);
 	if (err < 0)
 		goto out_free;
 
@@ -2371,8 +2374,10 @@ static int azx_probe_continue(struct azx *chip)
 	chip->ctl_dev_id = ctl_dev_id;
 
 	/* create codec instances */
+	dev_info(chip->card->dev, "HDACTRLDBG: before azx_probe_codecs codec_mask=0x%lx\n", bus->codec_mask);
 	if (bus->codec_mask) {
 		err = azx_probe_codecs(chip, azx_max_codecs[chip->driver_type]);
+		dev_info(chip->card->dev, "HDACTRLDBG: after azx_probe_codecs (err=%d)\n", err);
 		if (err < 0)
 			goto out_free;
 	}
diff --git a/sound/hda/core/controller.c b/sound/hda/core/controller.c
index 69e11d62b..6895e6bba 100644
--- a/sound/hda/core/controller.c
+++ b/sound/hda/core/controller.c
@@ -526,11 +526,14 @@ int snd_hdac_bus_reset_link(struct hdac_bus *bus, bool full_reset)
 		goto skip_reset;
 
 	/* clear STATESTS if not in reset */
+	dev_info(bus->dev, "HDACTRLDBG: reset_link reading GCTL\n");
 	if (snd_hdac_chip_readb(bus, GCTL) & AZX_GCTL_RESET)
 		snd_hdac_chip_writew(bus, STATESTS, STATESTS_INT_MASK);
+	dev_info(bus->dev, "HDACTRLDBG: reset_link after GCTL read\n");
 
 	/* reset controller */
 	snd_hdac_bus_enter_link_reset(bus);
+	dev_info(bus->dev, "HDACTRLDBG: reset_link after enter_link_reset\n");
 
 	/* delay for >= 100us for codec PLL to settle per spec
 	 * Rev 0.9 section 5.5.1
@@ -539,13 +542,16 @@ int snd_hdac_bus_reset_link(struct hdac_bus *bus, bool full_reset)
 
 	/* Bring controller out of reset */
 	snd_hdac_bus_exit_link_reset(bus);
+	dev_info(bus->dev, "HDACTRLDBG: reset_link after exit_link_reset\n");
 
 	/* Brent Chartrand said to wait >= 540us for codecs to initialize */
 	usleep_range(1000, 1200);
 
  skip_reset:
 	/* check to see if controller is ready */
+	dev_info(bus->dev, "HDACTRLDBG: reset_link reading GCTL for ready check\n");
 	if (!snd_hdac_chip_readb(bus, GCTL)) {
+		dev_info(bus->dev, "HDACTRLDBG: reset_link GCTL=0 NOT READY\n");
 		dev_dbg(bus->dev, "controller not ready!\n");
 		return -EBUSY;
 	}
@@ -553,6 +559,7 @@ int snd_hdac_bus_reset_link(struct hdac_bus *bus, bool full_reset)
 	/* detect codecs */
 	if (!bus->codec_mask) {
 		bus->codec_mask = snd_hdac_chip_readw(bus, STATESTS);
+		dev_info(bus->dev, "HDACTRLDBG: reset_link codec_mask=0x%lx\n", bus->codec_mask);
 		dev_dbg(bus->dev, "codec_mask = 0x%lx\n", bus->codec_mask);
 	}
 
@@ -608,11 +615,15 @@ static void azx_int_clear(struct hdac_bus *bus)
  */
 bool snd_hdac_bus_init_chip(struct hdac_bus *bus, bool full_reset)
 {
-	if (bus->chip_init)
+	if (bus->chip_init) {
+		dev_info(bus->dev, "HDACTRLDBG: bus_init_chip already init\n");
 		return false;
+	}
 
 	/* reset controller */
+	dev_info(bus->dev, "HDACTRLDBG: bus_init_chip calling reset_link\n");
 	snd_hdac_bus_reset_link(bus, full_reset);
+	dev_info(bus->dev, "HDACTRLDBG: bus_init_chip after reset_link\n");
 
 	/* clear interrupts */
 	azx_int_clear(bus);
@@ -630,6 +641,7 @@ bool snd_hdac_bus_init_chip(struct hdac_bus *bus, bool full_reset)
 	}
 
 	bus->chip_init = true;
+	dev_info(bus->dev, "HDACTRLDBG: bus_init_chip done\n");
 
 	return true;
 }

# vm/kernel/ae7.config — guest kernel fragment for the AE-7 VFIO rig.
# Merged on top of x86_64 defconfig + kernel/configs/kvm_guest.config by
# vm/kernel/build.sh, which fails if a line below is not in the final .config.

# Release string 7.2.10-ae7, distinct from the host modules.
CONFIG_LOCALVERSION="-ae7"
# CONFIG_LOCALVERSION_AUTO is not set

# Root is the host / over virtio-9p, with no initramfs: all built in.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y

# Console, early userspace, power-off through sysrq 'o'.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Modules: plain .ko files that the host kmod in the guest can load.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_SIG is not set

# Firmware: ctefx.bin is ctefx.bin.zst on the host.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_DEBUG=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# HD-audio: controller and codecs are modules, so they can be reloaded.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_DEBUG=y
CONFIG_SND_DEBUG_VERBOSE=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_CA0132_DSP=y
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_PATCH_LOADER=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0

# Debug aids: dynamic debug, hda:* tracepoints, kprobes, lockup reports.
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_EVENT_TRACING=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# Large defconfig parts that the guest does not use (shorter builds).
# CONFIG_DRM_I915 is not set
# CONFIG_CFG80211 is not set
# CONFIG_WLAN is not set
